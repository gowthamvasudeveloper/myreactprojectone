# Copy this file to ".env" and adjust values for your environment.
#
# Why this file exists:
# - It documents all environment variables the backend expects.
# - It keeps secrets out of source control (you should NOT commit your real ".env").

# App
APP_NAME="Expense Manager API"
ENVIRONMENT="local"  # local | staging | production
LOG_LEVEL="INFO"     # DEBUG | INFO | WARNING | ERROR

# API
API_V1_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Security (JWT)
# IMPORTANT: In production, set a long, random secret.
JWT_SECRET_KEY="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (MySQL)
# Example:
# mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL="mysql+pymysql://expense_user:expense_password@localhost:3306/expense_db"
